<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:PulseDock.Services"
                   >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PulseDock;component/Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />



    <DataTemplate x:Key="DotsIcon">
        <Path Data="{StaticResource IconDots}" Style="{StaticResource IconPath}" StrokeThickness="1.8" />
    </DataTemplate>
    <DataTemplate x:Key="ExpandIcon">
        <Path Data="{StaticResource IconExpand}" Style="{StaticResource IconPath}" StrokeThickness="1.5" />
    </DataTemplate>
    <DataTemplate x:Key="CollapseIcon">
        <Path Data="{StaticResource IconCollapse}" Style="{StaticResource IconPath}" StrokeThickness="1.5" />
    </DataTemplate>

    <!-- Reusable gear -->
    <DataTemplate x:Key="GearIcon">
        <Path Data="{StaticResource IconGear}" Style="{StaticResource IconPath}" StrokeThickness="1.5" />
    </DataTemplate>

    <!-- Network mini chart (points in a fixed 120×18 space) -->
    <DataTemplate x:Key="SparkDown">
        <Viewbox Stretch="Fill" Height="18">
            <Canvas Width="120" Height="18">
                <Polyline Points="{Binding DownPoints}" Stroke="{StaticResource DownBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
    <DataTemplate x:Key="SparkUp">
        <Viewbox Stretch="Fill" Height="18">
            <Canvas Width="120" Height="18">
                <Polyline Points="{Binding UpPoints}" Stroke="{StaticResource UpBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ================= EXPANDED ================= -->

    <DataTemplate x:Key="ExpandedMetric">
        <Border Padding="14,10,8,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ToolTip}">
            <StackPanel>
                <DockPanel MinHeight="28">
                    <Rectangle DockPanel.Dock="Left" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChevronButton}" Margin="8,0,0,0"
                            Command="{Binding OpenDetailsCommand}"
                            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource MonoValue}" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Label, Mode=OneWay}" />
                        <Run Text="{Binding Suffix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,6,6,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource MonoSmall}" Margin="10,0,0,0" />
                    <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedLayout">
        <Border Width="320" Background="{Binding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="14,6,6,6">
                    <Path DockPanel.Dock="Left" Data="{StaticResource IconPulse}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
<Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="{Binding [Menu], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⋯"
                    ContentTemplate="{StaticResource DotsIcon}" Command="{Binding OpenMenuCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{Binding [BackToCompact], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⤡"
                            ContentTemplate="{StaticResource CollapseIcon}" Command="{Binding SetLayoutCommand}" CommandParameter="CompactVertical" />
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconToggle}" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                  Command="{Binding TogglePinCommand}" ToolTip="{Binding [PinOnTop], Source={x:Static svc:Loc.Instance}, Mode=OneWay}">
                        <Path Data="{StaticResource IconPin}" Style="{StaticResource IconPath}" />
                    </ToggleButton>
                    <Border DockPanel.Dock="Right" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{StaticResource SoftTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding [App], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Height="1" Background="{StaticResource DividerBrush}" />

                <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource ExpandedMetric}" Focusable="False" />

                <!-- Network -->
                <StackPanel Margin="14,10,14,10" Visibility="{Binding NetVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="13" FontWeight="Medium" Margin="0,0,0,8">
                        <Run Text="{Binding [Network], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                        <Run Text="{Binding NetName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                    </TextBlock>
                    <UniformGrid Columns="2">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="↓ Download" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Margin="0,2,0,4">
                                    <Run Text="{Binding NetDown, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DownBrush}" />
                                    <Run Text="{Binding NetDownUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SparkDown}" Focusable="False" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="↑ Upload" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Margin="0,2,0,4">
                                    <Run Text="{Binding NetUp, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}" />
                                    <Run Text="{Binding NetUpUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SparkUp}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <Border Height="1" Background="{StaticResource DividerBrush}" />
                <DockPanel Margin="14,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FooterRight}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding FooterLeft}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================= COMPACT VERTICAL ================= -->

    <DataTemplate x:Key="CompactMetric">
        <Button Style="{StaticResource RowButton}" Padding="6,5" Margin="0,1"
                Command="{Binding OpenDetailsCommand}" ToolTipService.ShowOnDisabled="True"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ToolTip}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CompactLabel}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource MonoValue}" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding DetailCompact}" Style="{StaticResource MonoSmall}" HorizontalAlignment="Right" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="4" Data="{StaticResource IconChevronRight}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ProgressBar Style="{StaticResource MeterBar}" Height="2" Margin="0,4,0,0" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Last row: network + gear (no title bar) -->
    <DataTemplate x:Key="CompactNetRow">
        <DockPanel Margin="6,0,0,0" MinHeight="28">
<Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{Binding [Menu], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⋯"
                    ContentTemplate="{StaticResource DotsIcon}" Command="{Binding OpenMenuCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{Binding [ExpandFull], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⤢"
                    ContentTemplate="{StaticResource ExpandIcon}" Command="{Binding SetLayoutCommand}" CommandParameter="Expanded" />
            <Grid Visibility="{Binding NetVisible, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" ToolTip="{Binding NetName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding [Network], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,4,0">
                    <Run Text="↓" Foreground="{StaticResource DownBrush}" /><Run Text="{Binding NetDownCompact, Mode=OneWay}" Foreground="{StaticResource DownBrush}" />
                    <Run Text="  ↑" Foreground="{StaticResource UpBrush}" /><Run Text="{Binding NetUp, Mode=OneWay}" Foreground="{StaticResource UpBrush}" />
                    <Run Text="{Binding NetUpUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="CompactVerticalLayout">
        <Border Width="290" Background="{Binding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,4,4,2">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource CompactMetric}" Focusable="False" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CompactNetRow}" Focusable="False" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================= HORIZONTAL STRIP ================= -->

    <DataTemplate x:Key="StripMetric">
        <Button Style="{StaticResource RowButton}" Padding="10,0" Height="32"
                Command="{Binding OpenDetailsCommand}" ToolTipService.ShowOnDisabled="True"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ShortLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource MonoValue}" FontSize="12" Margin="0,0,6,0" />
                <TextBlock Text="{Binding DetailShort}" Style="{StaticResource MonoSmall}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="CompactHorizontalLayout">
        <Border Height="44" Background="{Binding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4,0,4,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource StripMetric}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="4,0" VerticalAlignment="Center"
                        Visibility="{Binding NetVisible, Converter={StaticResource BoolToVis}}" />
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="10,0"
                           Visibility="{Binding NetVisible, Converter={StaticResource BoolToVis}}" ToolTip="{Binding NetName}">
                    <Run Text="↓" Foreground="{StaticResource DownBrush}" /><Run Text="{Binding NetDownCompact, Mode=OneWay}" Foreground="{StaticResource DownBrush}" />
                    <Run Text="  ↑" Foreground="{StaticResource UpBrush}" /><Run Text="{Binding NetUp, Mode=OneWay}" Foreground="{StaticResource UpBrush}" />
                    <Run Text="{Binding NetUpUnit, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </TextBlock>
<Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="{Binding [ExpandFull], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⤢"
                    ContentTemplate="{StaticResource ExpandIcon}" Command="{Binding SetLayoutCommand}" CommandParameter="Expanded" />
                <Button Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="{Binding [Menu], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Content="⋯"
                    ContentTemplate="{StaticResource DotsIcon}" Command="{Binding OpenMenuCommand}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Picks the layout from the Layout value -->
    <Style x:Key="LayoutHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ContentTemplate" Value="{StaticResource CompactVerticalLayout}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Layout}" Value="Expanded">
                <Setter Property="ContentTemplate" Value="{StaticResource ExpandedLayout}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Layout}" Value="CompactHorizontal">
                <Setter Property="ContentTemplate" Value="{StaticResource CompactHorizontalLayout}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

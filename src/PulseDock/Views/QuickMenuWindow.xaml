<Window x:Class="PulseDock.Views.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:PulseDock.Services"
        Title="{Binding [WinMenu], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Clicking any button closes the menu (ButtonBase.Click bubbles up to here). -->
    <Border Width="260" Style="{StaticResource WindowFrame}" Padding="6" ButtonBase.Click="AnyButton_Click">
        <StackPanel>
            <Button Style="{StaticResource MenuRow}" Command="{Binding ToggleExpandCommand}">
                <TextBlock Text="{Binding ExpandToggleText}" />
            </Button>
            <Button Style="{StaticResource MenuRow}" Content="{Binding [ViewProcesses], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding OpenProcessesCommand}" />

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,6" />

            <TextBlock Text="{Binding [LayoutTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}" Margin="10,2,0,6" />
            <WrapPanel Margin="10,0,6,4">
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmLayout" Content="{Binding [LayoutCompact], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsLayoutCompactV, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="CompactVertical" />
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmLayout" Content="{Binding [LayoutFull], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsLayoutExpanded, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="Expanded" />
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmLayout" Content="{Binding [LayoutStrip], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsLayoutStrip, Mode=OneWay}" Command="{Binding SetLayoutCommand}" CommandParameter="CompactHorizontal" />
            </WrapPanel>

            <TextBlock Text="{Binding [ModeTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}" Margin="10,4,0,6" />
            <WrapPanel Margin="10,0,6,4">
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmMode" Content="{Binding [ModeOverlay], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsModeOverlay, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Overlay" />
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmMode" Content="{Binding [ModeDesktop], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsModeDesktop, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Desktop" />
                <RadioButton Style="{StaticResource SmallPill}" GroupName="QmMode" Content="{Binding [ModeTray], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                             IsChecked="{Binding IsModeTray, Mode=OneWay}" Command="{Binding SetModeCommand}" CommandParameter="Tray" />
            </WrapPanel>

            <TextBlock Text="{Binding [PositionTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SectionTitle}" Margin="10,4,0,6" />
            <DockPanel Margin="10,0,6,4">
                <UniformGrid DockPanel.Dock="Left" Rows="2" Columns="2" Width="72" Margin="0,0,10,0">
                    <RadioButton Style="{StaticResource SmallPill}" GroupName="QmCorner" Content="↖" ToolTip="{Binding [CornerTL], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsCornerTL, Mode=OneWay}" Command="{Binding SetCornerCommand}" CommandParameter="TopLeft" />
                    <RadioButton Style="{StaticResource SmallPill}" GroupName="QmCorner" Content="↗" ToolTip="{Binding [CornerTR], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsCornerTR, Mode=OneWay}" Command="{Binding SetCornerCommand}" CommandParameter="TopRight" />
                    <RadioButton Style="{StaticResource SmallPill}" GroupName="QmCorner" Content="↙" ToolTip="{Binding [CornerBL], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsCornerBL, Mode=OneWay}" Command="{Binding SetCornerCommand}" CommandParameter="BottomLeft" />
                    <RadioButton Style="{StaticResource SmallPill}" GroupName="QmCorner" Content="↘" ToolTip="{Binding [CornerBR], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                 IsChecked="{Binding IsCornerBR, Mode=OneWay}" Command="{Binding SetCornerCommand}" CommandParameter="BottomRight" />
                </UniformGrid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [DragHint], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <CheckBox Style="{StaticResource ToggleSwitch}" MinHeight="36" Margin="10,0,6,0" Content="{Binding [LockPosition], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                      IsChecked="{Binding IsPositionLocked}" />

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="4,6" />

            <Button Style="{StaticResource MenuRow}" Content="{Binding [SettingsEllipsis], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding OpenSettingsCommand}" />
            <Button Style="{StaticResource MenuRow}" Content="{Binding [Quit], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding ExitCommand}" Foreground="{StaticResource ErrorTextBrush}" />
        </StackPanel>
    </Border>
</Window>

<Window x:Class="PulseDock.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:PulseDock.Services"
        Title="{Binding [WinProcesses], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
        Width="460" Height="600"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource WindowFrame}">
        <DockPanel LastChildFill="True">

            <!-- Header (draggable) -->
            <DockPanel DockPanel.Dock="Top" Margin="16,8,8,8" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{Binding [CloseEsc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding CloseCommand}">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource IconPath}" Width="14" Height="14" />
                </Button>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" />

            <!-- Tabs -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,12,16,2">
                <RadioButton Style="{StaticResource PillRadio}" GroupName="DetailsTab" Content="CPU" IsChecked="{Binding IsCpuTab}" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="DetailsTab" Content="{Binding [Memory], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" IsChecked="{Binding IsMemoryTab}" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="DetailsTab" Content="{Binding [Disk], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" IsChecked="{Binding IsDiskTab}" />
            </StackPanel>

            <DockPanel DockPanel.Dock="Top" Margin="16,2,16,10">
                <TextBlock DockPanel.Dock="Right" Text="{Binding [Top10], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Table header -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1" Padding="25,6,25,6">
                <Grid TextElement.Foreground="{StaticResource MutedBrush}" TextElement.FontSize="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding [ColProcess], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="PID" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{Binding ColumnLabel}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <DockPanel Visibility="{Binding NotConfirming, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{Binding [EndTask], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                Command="{Binding AskEndCommand}" IsEnabled="{Binding HasSelection}" />
                        <TextBlock Text="{Binding SelectionText}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    </DockPanel>
                    <StackPanel Visibility="{Binding Confirming, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="13" TextWrapping="Wrap">
                            <Run Text="{Binding [End], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                            <Run Text="{Binding SelectedName, Mode=OneWay}" FontWeight="Bold" /><Run Text="{Binding [ConfirmPost], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding [Cancel], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True" />
                            <Button Style="{StaticResource DangerButton}" Content="{Binding [End], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding ConfirmEndCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Notice -->
            <Border DockPanel.Dock="Bottom" Margin="16,0,16,8" Padding="12,8" CornerRadius="8"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource ErrorTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Toast}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- List -->
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="8,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ProcessItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="5" Background="{StaticResource TrackBrush}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SoftTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource MonoSmall}" FontSize="12" HorizontalAlignment="Right" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource MonoValue}" HorizontalAlignment="Right" />
                                <ProgressBar Style="{StaticResource MeterBar}" Height="4" Margin="0,4,0,0"
                                             Value="{Binding BarPercent, Mode=OneWay}" Foreground="{Binding Brush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
